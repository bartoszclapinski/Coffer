<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.10.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.17" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.17" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.17" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="NBitcoin" Version="7.0.50" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.17" />
    <!-- SECURITY: ".Core" on purpose. The non-Core Microsoft.EntityFrameworkCore.Sqlite
         drags in SQLitePCLRaw.bundle_e_sqlite3, which ships its own SQLitePCLRaw.batteries_v2.dll
         bound to the plain (unencrypted) e_sqlite3 provider. When that bundle's version is
         higher than bundle_e_sqlcipher's, its batteries wins, PRAGMA key is silently ignored
         and the vault is written in plaintext. bundle_e_sqlcipher must be the only bundle in
         the graph; SqlCipherKeyInterceptor additionally fails closed if it is not loaded. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="9.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.17">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="zxcvbn-core" Version="7.0.92" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <!-- Windows-1250 (the PKO "Historia rachunku" CSV encoding) is not a built-in
         code page on modern .NET; CodePagesEncodingProvider must be registered. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coffer.Core\Coffer.Core.csproj" />
    <ProjectReference Include="..\Coffer.Shared\Coffer.Shared.csproj" />
  </ItemGroup>

</Project>
