<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Coffer.Application.ViewModels.Settings;assembly=Coffer.Application"
             xmlns:l="clr-namespace:Coffer.Desktop.Localization"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
             x:Class="Coffer.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="False">
    <UserControl.Resources>
        <!-- Provider + model pickers of one AI role (Categorization / Analysis share it). -->
        <DataTemplate x:Key="AiRoleRouteTemplate" x:DataType="vm:AiRoleRouteViewModel">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                        <TextBlock Text="{l:Localize Settings.Ai.Provider}" Classes="muted" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                        <TextBlock Text="{l:Localize Settings.Ai.Model}" Classes="muted" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Models}"
                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                  PlaceholderText="{l:Localize Settings.Ai.Model.Placeholder}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding CapabilitiesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{l:Localize Settings.Ai.Model.Capabilities}" Classes="muted" />
                    <TextBlock Text="{Binding CapabilitiesText}" Classes="muted" />
                </StackPanel>

                <TextBlock Text="{l:Localize Settings.Ai.Model.NotListed}"
                           Foreground="{DynamicResource Coffer.Neg}" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding ModelNotListed}" />
                <TextBlock Text="{l:Localize Settings.Ai.Model.NoTools}"
                           Foreground="{DynamicResource Coffer.Neg}" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding ModelLacksTools}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="22" Spacing="20" MaxWidth="560" HorizontalAlignment="Left">

            <!-- Appearance / theme -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings.Theme.Section}" Classes="title" />

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{l:Localize Settings.Theme.Label}" Foreground="{DynamicResource Coffer.Tx}" />
                            <TextBlock Text="{l:Localize Settings.Theme.Hint}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- Empty On/Off content: the label on the left says what it does, and
                             Fluent's built-in "On"/"Off" text is English-only. -->
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Language -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings.Language.Section}" Classes="title" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:Localize Settings.Language.Label}" Classes="muted" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AI providers + models, one block per role (Sprint 31-D) -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{l:Localize Settings.Ai.Section}" Classes="title" />
                        <TextBlock Text="{l:Localize Settings.Ai.Hint}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Background="{DynamicResource Coffer.Panel2}" CornerRadius="10" Padding="14,12">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:Localize Settings.Ai.Role.Categorization}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Coffer.Tx}" />
                                <TextBlock Text="{l:Localize Settings.Ai.Role.CategorizationHint}"
                                           Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <ContentControl Content="{Binding Categorization}"
                                            ContentTemplate="{StaticResource AiRoleRouteTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Coffer.Panel2}" CornerRadius="10" Padding="14,12">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:Localize Settings.Ai.Role.Analysis}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Coffer.Tx}" />
                                <TextBlock Text="{l:Localize Settings.Ai.Role.AnalysisHint}"
                                           Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <ContentControl Content="{Binding Analysis}"
                                            ContentTemplate="{StaticResource AiRoleRouteTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Ollama server: endpoint, connection test, model list -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{l:Localize Settings.Ai.Ollama.Section}" Classes="title" />
                        <TextBlock Text="{l:Localize Settings.Ai.Ollama.Hint}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:Localize Settings.Ai.Ollama.Endpoint}" Classes="muted" />
                        <TextBox Text="{Binding OllamaEndpointText, Mode=TwoWay}"
                                 Watermark="http://localhost:11434" />
                        <TextBlock Text="{l:Localize Settings.Ai.Ollama.EndpointInvalid}"
                                   Foreground="{DynamicResource Coffer.Neg}" FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding IsEndpointInvalid}" />
                    </StackPanel>

                    <Border Background="{DynamicResource Coffer.NegTint}"
                            BorderBrush="{DynamicResource Coffer.Neg}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            IsVisible="{Binding IsEndpointRemote}">
                        <TextBlock Text="{l:Localize Settings.Ai.Ollama.RemoteWarning}"
                                   Foreground="{DynamicResource Coffer.Neg}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:Localize Settings.Ai.Ollama.Test}"
                                Classes="chip"
                                Command="{Binding TestOllamaConnectionCommand}" />
                        <Button Content="{l:Localize Settings.Ai.Ollama.Refresh}"
                                Classes="chip"
                                Command="{Binding RefreshOllamaModelsCommand}" />
                    </StackPanel>

                    <Border Background="{DynamicResource Coffer.PosTint}" CornerRadius="8" Padding="10"
                            IsVisible="{Binding ConnectionSucceeded}">
                        <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{DynamicResource Coffer.Pos}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <Border Background="{DynamicResource Coffer.NegTint}" CornerRadius="8" Padding="10"
                            IsVisible="{Binding ConnectionFailed}">
                        <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{DynamicResource Coffer.Neg}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <Panel IsVisible="{Binding OllamaModelsStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding OllamaModelsStatusText}" Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding !OllamaModelsFailed}" />
                        <TextBlock Text="{Binding OllamaModelsStatusText}" Foreground="{DynamicResource Coffer.Neg}"
                                   FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding OllamaModelsFailed}" />
                    </Panel>
                </StackPanel>
            </Border>

            <!-- Claude API key -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{l:Localize Settings.ApiKey.Section}" Classes="title" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{l:Localize Settings.ApiKey.Hint}" />
                    </StackPanel>

                    <Border Background="{DynamicResource Coffer.PosTint}" CornerRadius="8" Padding="10"
                            IsVisible="{Binding HasApiKey}">
                        <TextBlock Text="{l:Localize Settings.ApiKey.Present}" Foreground="{DynamicResource Coffer.Pos}" FontSize="12" />
                    </Border>
                    <Border Background="{DynamicResource Coffer.NegTint}" CornerRadius="8" Padding="10"
                            IsVisible="{Binding ShowMissingApiKey}">
                        <TextBlock Text="{l:Localize Settings.ApiKey.Absent}" Foreground="{DynamicResource Coffer.Neg}" FontSize="12" />
                    </Border>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:Localize Settings.ApiKey.New}" Classes="muted" />
                        <TextBox PasswordChar="•"
                                 Text="{Binding ApiKeyInput, Mode=TwoWay}"
                                 Watermark="sk-ant-…" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:Localize Settings.ApiKey.Save}"
                                Classes="chip"
                                Command="{Binding SaveApiKeyCommand}" />
                        <Button Content="{l:Localize Settings.ApiKey.Clear}"
                                Classes="chip"
                                Command="{Binding ClearApiKeyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Budget -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings.Budget.Section}" Classes="title" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:Localize Settings.Budget.Cap}" Classes="muted" />
                        <NumericUpDown Minimum="0"
                                       Increment="5"
                                       FormatString="0.00"
                                       Value="{Binding MonthlyCapPln, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:Localize Settings.Budget.Spent}" Classes="muted" />
                        <TextBlock Classes="money" FontSize="18"
                                   Text="{Binding CurrentMonthSpendPln, StringFormat='{}{0:0.00} PLN'}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Planning: safety floor -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings.Planning.Section}" Classes="title" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:Localize Settings.Planning.SafetyFloor}" Classes="muted" />
                        <NumericUpDown Minimum="0"
                                       Increment="100"
                                       FormatString="0.00"
                                       Value="{Binding SafetyFloorPln, Mode=TwoWay}" />
                        <TextBlock Text="{l:Localize Settings.Planning.SafetyFloorHint}"
                                   Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Account balance anchors -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{l:Localize Settings.Anchor.Section}" Classes="title" />
                        <TextBlock Text="{l:Localize Settings.Anchor.Hint}"
                                   Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Text="{l:Localize Settings.Anchor.NoAccounts}"
                               Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding !HasAccounts}" />

                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccountAnchorRowViewModel">
                                <Border Background="{DynamicResource Coffer.Panel2}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource Coffer.Tx}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" CornerRadius="6" Padding="8,2"
                                                    Background="{DynamicResource Coffer.PosTint}" VerticalAlignment="Center"
                                                    IsVisible="{Binding HasAnchor}">
                                                <TextBlock Text="{l:Localize Settings.Anchor.Set}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Coffer.Pos}" />
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                                                <TextBlock Text="{l:Localize Settings.Anchor.Balance}"
                                                           Classes="muted" />
                                                <NumericUpDown Increment="100" FormatString="0.00"
                                                               Value="{Binding AnchorBalance}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0">
                                                <TextBlock Text="{l:Localize Settings.Anchor.Date}"
                                                           Classes="muted" />
                                                <DatePicker SelectedDate="{Binding AnchorDate}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{l:Localize Settings.Anchor.Save}"
                                                    Classes="chip"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    Command="{Binding SaveAnchorCommand}" />
                                            <Button Content="{l:Localize Settings.Anchor.Clear}"
                                                    Classes="chip"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    Command="{Binding ClearAnchorCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- AI fallback parsing -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l:Localize Settings.AiFallback.Section}" Classes="title" />

                    <CheckBox Content="{l:Localize Settings.AiFallback.Toggle}"
                              IsChecked="{Binding AiFallbackParsingEnabled, Mode=TwoWay}" />
                    <TextBlock Text="{l:Localize Settings.AiFallback.Consent}"
                               Classes="muted" TextWrapping="Wrap" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:Localize Settings.AiFallback.OwnerName}" Classes="muted" />
                        <TextBox Text="{Binding OwnerIdentityNames, Mode=TwoWay}" />
                        <TextBlock Text="{l:Localize Settings.AiFallback.OwnerNameHint}"
                                   Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup & Recovery -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{l:Localize Settings.Backup.Section}" Classes="title" />
                        <TextBlock Text="{l:Localize Settings.Backup.Hint}"
                                   Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{l:Localize Settings.Backup.LastSnapshot}" Classes="muted" />
                            <TextBlock Text="{Binding LastDailySnapshotText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Coffer.Tx}" />
                            <TextBlock Text="{Binding NewestSnapshotAgeText}"
                                       Classes="muted"
                                       IsVisible="{Binding !IsBackupStale}" />
                            <TextBlock Text="{Binding NewestSnapshotAgeText}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Coffer.Neg}"
                                       IsVisible="{Binding IsBackupStale}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{l:Localize Settings.Backup.Count}" Classes="muted" />
                            <TextBlock Text="{Binding DailyBackupCountText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Coffer.Tx}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Coffer.NegTint}"
                            BorderBrush="{DynamicResource Coffer.Neg}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            IsVisible="{Binding HasBackupFailure}">
                        <TextBlock Text="{Binding LastBackupFailureText}"
                                   Foreground="{DynamicResource Coffer.Neg}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:Localize Settings.Backup.Now}"
                                Classes="chip"
                                IsEnabled="{Binding !IsBusy}"
                                Command="{Binding BackupNowCommand}" />
                        <Button Content="{l:Localize Settings.Backup.Export}"
                                Classes="chip"
                                IsEnabled="{Binding !IsBusy}"
                                Command="{Binding ExportArchiveCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:Localize Settings.Restore.Button}"
                                Classes="chip"
                                IsEnabled="{Binding !IsBusy}"
                                Command="{Binding RestoreFromSnapshotCommand}" />
                    </StackPanel>

                    <TextBlock Text="{l:Localize Settings.Restore.Note}"
                               Classes="muted" TextWrapping="Wrap" />

                    <TextBlock Text="{l:Localize Settings.SeedRecovery.Section}"
                               Classes="title" Margin="0,8,0,0" />
                    <TextBlock Text="{l:Localize Settings.SeedRecovery.EnabledState}"
                               FontSize="13" Foreground="{DynamicResource Coffer.Pos}"
                               IsVisible="{Binding SeedRecoveryEnabled}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding !SeedRecoveryEnabled}">
                        <Button Content="{l:Localize Settings.SeedRecovery.Enable}"
                                Classes="chip"
                                IsEnabled="{Binding !IsBusy}"
                                Command="{Binding EnableSeedRecoveryCommand}" />
                    </StackPanel>
                    <TextBlock Text="{l:Localize Settings.SeedRecovery.Hint}"
                               Classes="muted" TextWrapping="Wrap" />

                    <TextBlock Text="{l:Localize Settings.Password.Section}"
                               Classes="title" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:Localize Settings.Password.Change}"
                                Classes="chip"
                                IsEnabled="{Binding !IsBusy}"
                                Command="{Binding ChangeMasterPasswordCommand}" />
                    </StackPanel>
                    <TextBlock Text="{l:Localize Settings.Password.Hint}"
                               Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{l:Localize Settings.Save}"
                        Classes="accent"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding !IsBusy}" />
                <TextBlock VerticalAlignment="Center"
                           Classes="muted"
                           Text="{Binding StatusMessage}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
